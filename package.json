    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.0"
  }
}

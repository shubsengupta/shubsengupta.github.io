---
const fmt = new Intl.DateTimeFormat('en-CA', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Toronto', timeZoneName: 'short' });
const now = fmt.format(new Date()).replace(',', '');
---
<header class="masthead wrap">
  <a href="/" class="who">
    <span class="face">
      <img src="/shub.png" alt="Shub Sengupta" width="72" height="72" />
      <span class="wave" aria-hidden="true">👋</span>
    </span>
    <span class="text">
      <h1>Shub Sengupta</h1>
      <p class="title">Engineering Manager at Customer.io. Content and Frontend Platform.</p>
    </span>
  </a>
  <p class="mono where">Kitchener, Ontario <time id="clock" datetime={new Date().toISOString()}>{now}</time></p>
</header>
<script>
  const el = document.getElementById('clock');
  const fmt = new Intl.DateTimeFormat('en-CA', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Toronto', timeZoneName: 'short' });
  const tick = () => { if (el) el.textContent = fmt.format(new Date()).replace(',', ''); };
  tick();
  setInterval(tick, 15_000);
</script>
<style>
  .masthead { display: flex; align-items: flex-end; justify-content: space-between; padding: 2.5rem 1.5rem 1.25rem; gap: 1rem 2rem; flex-wrap: wrap; }
  .who { display: flex; align-items: center; gap: 1.1rem; text-decoration: none; }
  .face { position: relative; flex: none; }
  .face img { display: block; width: 4.5rem; height: 4.5rem; border-radius: 999px; object-fit: cover; box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--surface-2); }
  .wave { position: absolute; right: -0.55rem; bottom: -0.25rem; font-size: 1.5rem; line-height: 1; transform-origin: 70% 75%; animation: wave 1.6s ease-in-out 0.5s 1 both; }
  .who:hover .wave { animation: wave 1.2s ease-in-out infinite; }
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    15% { transform: rotate(18deg); }
    30% { transform: rotate(-10deg); }
    45% { transform: rotate(18deg); }
    60% { transform: rotate(-6deg); }
    75% { transform: rotate(10deg); }
  }
  h1 { font-weight: 700; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.035em; margin: 0; line-height: 0.95; font-variation-settings: 'opsz' 96; }
  .title { margin: 0.45rem 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.35; }
  .where { margin: 0 0 0.2rem; color: var(--muted); }
  .where time { margin-left: 0.6rem; color: var(--ink); }
  @media (max-width: 40rem) {
    .masthead { align-items: flex-start; }
    .face img { width: 3.5rem; height: 3.5rem; }
    .wave { font-size: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .wave, .who:hover .wave { animation: none; } }
</style>

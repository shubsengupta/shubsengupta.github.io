---
interface Props { title: string; id: string }
const { title, id } = Astro.props;
---
<section class="sec wrap" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{title}</h2>
  <div class="body">
    <slot />
  </div>
</section>
<style>
  .sec { display: grid; grid-template-columns: 14rem 1fr; gap: 0.5rem 2rem; padding: 2.75rem 1.5rem; border-top: 1px solid var(--line); }
  h2 { margin: 0; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .body { max-width: var(--measure); font-size: 1.05rem; line-height: 1.6; }
  .body :global(p) { margin: 0 0 1rem; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .body :global(ul) { padding: 0; margin: 0; list-style: none; }
  @media (max-width: 48rem) { .sec { grid-template-columns: 1fr; gap: 0.75rem; padding: 2.25rem 1.5rem; } }
</style>

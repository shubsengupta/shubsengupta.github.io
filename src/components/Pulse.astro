---
import { renderGrid, gridHeight, readout, stats, availableYears, latestActive, monthLabels, yearTotals, fmtTokens, type PulseData, type SourceKey } from '../lib/pulse';
import cioMark from '../assets/brand/customerio.svg?raw';
import claudeMark from '../assets/brand/claude.svg?raw';
interface Props { data: PulseData }
const { data } = Astro.props;
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const GUTTER = 22;
const years = availableYears(data);
const year = years[0];
const hidden = new Set<SourceKey>();
const initialDate = latestActive(data);
const s = stats(data, year, hidden);
const legend: SourceKey[] = ['cio', 'vidyard', 'personal', 'agent'];
const totals = yearTotals(data);
const maxYear = Math.max(...totals.map((t) => t.total), 1);

// One full strip for wide screens, two half-year strips stacked for phones.
const strips = [
  { id: 'full', colFrom: 0, colTo: 52 },
  { id: 'a', colFrom: 0, colTo: 26 },
  { id: 'b', colFrom: 27, colTo: 52 },
];
const H = gridHeight({ cell: CELL, gap: GAP });
const widthOf = (c: { colFrom: number; colTo: number }) => (c.colTo - c.colFrom + 1) * STEP - GAP;
const weekdays = [{ row: 1, t: 'M' }, { row: 3, t: 'W' }, { row: 5, t: 'F' }];
const dayLabels = weekdays.map((w) => `<text class="dow" x="${-GUTTER + 4}" y="${w.row * STEP + CELL - 2}">${w.t}</text>`).join('');

---
<section class="pulse wrap" aria-label="GitHub activity" data-years={years.join(',')}>
  <div class="head">
    <div class="yearnav mono">
      <button class="step" data-step="1" aria-label="Earlier year">‹</button>
      <span id="pulse-year">{year}</span>
      <button class="step" data-step="-1" aria-label="Later year" disabled>›</button>
    </div>
    <div class="legend" role="group" aria-label="Sources">
      {legend.map((k) => (
        <button class="src" data-source={k} aria-pressed="true" style={`--ink:${data.sources[k].ink}`}>
          {k === 'cio' && <span class="mark cio" set:html={cioMark} />}
          {k === 'vidyard' && <span class="mark vidyard"><img src="/brand/vidyard.png" alt="" width="14" height="14" /></span>}
          {k === 'personal' && <span class="mark personal"><i></i></span>}
          {k === 'agent' && <span class="mark agent" set:html={claudeMark} />}
          {data.sources[k].label}
        </button>
      ))}
    </div>
  </div>

  {strips.map((c) => (
    <div class={`strip strip-${c.id}`} data-col-from={c.colFrom} data-col-to={c.colTo}>
      <svg class="months mono" viewBox={`${-GUTTER} 0 ${widthOf(c) + GUTTER} 12`} width="100%" aria-hidden="true">
        {monthLabels(year, c.colFrom, c.colTo).map((m) => <text x={m.col * STEP} y="10">{m.label}</text>)}
      </svg>
      <svg
        id={c.id === 'full' ? 'pulse-svg' : `pulse-svg-${c.id}`}
        class="grid enter"
        viewBox={`${-GUTTER} 0 ${widthOf(c) + GUTTER} ${H}`}
        width="100%"
        role="img"
        aria-labelledby="pulse-desc"
        tabindex={c.id === 'full' ? 0 : -1}
        set:html={dayLabels + renderGrid(data, year, hidden, { cell: CELL, gap: GAP, colFrom: c.colFrom, colTo: c.colTo })}
      />
    </div>
  ))}

  <div class="tip mono" id="pulse-tip" hidden role="status"></div>

  <p class="mono readout" id="pulse-readout" aria-live="polite">{readout(data, initialDate)}</p>

  <dl class="stats">
    <div class="claude"><dd id="st-chats">{s.chats.toLocaleString('en-CA')}</dd><dt>Claude Code chats</dt></div>
    <div class="claude"><dd id="st-tokens">{fmtTokens(s.tokens)}</dd><dt>tokens from Claude</dt></div>
    <div><dd id="st-prs">{s.prs}</dd><dt><span id="st-agent">{s.agentShare}%</span> of PRs built with Claude</dt></div>
    <div><dd id="st-reviews">{s.reviews}</dd><dt>PRs reviewed for others</dt></div>
  </dl>

  <div class="career" role="group" aria-label="Pick a year">
    {totals.map((t) => (
      <button class="yr" data-year={t.year} aria-pressed={t.year === year ? 'true' : 'false'} title={`${t.year}: ${t.total} contributions`}>
        <span class="bar" aria-hidden="true">
          {(['agent', 'personal', 'vidyard', 'cio'] as SourceKey[]).map((k) => (
            <i data-source={k} style={`height:${Math.round(((t.by[k] ?? 0) / maxYear) * 100)}%`}></i>
          ))}
        </span>
        <span class="mono lbl">{String(t.year).slice(2)}</span>
      </button>
    ))}
  </div>

  <p id="pulse-desc" class="sr">Daily GitHub contributions over a year, one column per week, stacked by source: Customer.io, Vidyard and personal. Claude Code chats stack on top of each day in Claude's colour, lighter for smaller models. Use arrow keys to move between days. The row of yearly bars picks a year.</p>
</section>

<script>
  import { renderGrid, readout, stats, monthLabels, yearSummary, dayRows, formatDate, mergeClaude, fmtTokens, type PulseData, type ClaudeData, type SourceKey } from '../lib/pulse';
  import pulse from '../data/pulse.json';
  import claude from '../data/claude.json';

  const d = mergeClaude(pulse as PulseData, claude as ClaudeData);
  const root = document.querySelector<HTMLElement>('.pulse')!;
  const out = document.getElementById('pulse-readout')!;
  const tip = document.getElementById('pulse-tip')!;
  const yearEl = document.getElementById('pulse-year')!;
  const years = root.dataset.years!.split(',').map(Number);
  const CELL = 11;
  const GAP = 3;
  const STEP = CELL + GAP;
  const strips = [...root.querySelectorAll<HTMLElement>('.strip')];
  const dayLabels = [...root.querySelector('.grid')!.querySelectorAll('.dow')].map((t) => t.outerHTML).join('');
  let idx = 0;
  const hidden = new Set<SourceKey>();
  let pinned: string | null = null;
  let focused: string | null = null;

  const clearFocus = () => root.querySelectorAll('.focus').forEach((el) => el.classList.remove('focus'));
  const markFocus = (date: string) => root.querySelectorAll(`.day[data-date="${date}"]`).forEach((el) => el.classList.add('focus'));
  const show = (date: string) => { out.textContent = readout(d, date); };

  function placeTip(date: string, anchor: Element) {
    const rows = dayRows(d, date);
    tip.innerHTML = `<b>${formatDate(date)}</b>` + (rows.length
      ? rows.map((r) => `<span><i style="${r.ink ? `background:${r.ink}` : 'visibility:hidden'}"></i>${r.n} ${r.label}</span>`).join('')
      : '<span class="quiet">no activity</span>');
    tip.hidden = false;
    const a = anchor.getBoundingClientRect();
    const r = root.getBoundingClientRect();
    const tw = tip.offsetWidth;
    let x = a.left - r.left + a.width / 2 - tw / 2;
    x = Math.max(0, Math.min(r.width - tw, x));
    tip.style.transform = `translate(${x}px, ${a.top - r.top - tip.offsetHeight - 8}px)`;
  }
  const hideTip = () => { if (!pinned) tip.hidden = true; };

  function paint() {
    const year = years[idx];
    for (const st of strips) {
      const colFrom = Number(st.dataset.colFrom);
      const colTo = Number(st.dataset.colTo);
      const grid = st.querySelector<SVGSVGElement>('.grid')!;
      grid.classList.remove('enter');
      grid.innerHTML = dayLabels + renderGrid(d, year, hidden, { cell: CELL, gap: GAP, colFrom, colTo });
      st.querySelector('.months')!.innerHTML = monthLabels(year, colFrom, colTo).map((m) => `<text x="${m.col * STEP}" y="10">${m.label}</text>`).join('');
    }
    yearEl.textContent = String(year);
    root.querySelectorAll<HTMLButtonElement>('.step').forEach((b) => {
      const n = idx + Number(b.dataset.step);
      b.disabled = n < 0 || n >= years.length;
    });
    root.querySelectorAll<HTMLButtonElement>('.yr').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.year) === year)));
    const s = stats(d, year, hidden);
    document.getElementById('st-chats')!.textContent = s.chats.toLocaleString('en-CA');
    document.getElementById('st-tokens')!.textContent = fmtTokens(s.tokens);
    document.getElementById('st-prs')!.textContent = String(s.prs);
    document.getElementById('st-agent')!.textContent = `${s.agentShare}%`;
    document.getElementById('st-reviews')!.textContent = String(s.reviews);
    if (focused) markFocus(focused);
  }

  function gotoYear(year: number) {
    const n = years.indexOf(year);
    if (n < 0) return;
    idx = n;
    pinned = null;
    focused = null;
    tip.hidden = true;
    paint();
    out.textContent = yearSummary(d, year, hidden);
  }

  for (const st of strips) {
    const svg = st.querySelector<SVGSVGElement>('.grid')!;
    svg.addEventListener('pointerover', (e) => {
      const g = (e.target as Element).closest<SVGElement>('[data-date]');
      if (!g) return;
      out.classList.add('live');
      if (!pinned) { show(g.dataset.date!); placeTip(g.dataset.date!, g); }
    });
    svg.addEventListener('pointerleave', () => {
      out.classList.toggle('live', pinned !== null);
      if (pinned) show(pinned);
      hideTip();
    });
    svg.addEventListener('click', (e) => {
      const g = (e.target as Element).closest<SVGElement>('[data-date]');
      if (!g) return;
      const date = g.dataset.date!;
      pinned = pinned === date ? null : date;
      focused = pinned;
      clearFocus();
      if (pinned) { markFocus(pinned); placeTip(pinned, g); } else { tip.hidden = true; }
      out.classList.toggle('live', pinned !== null);
      show(date);
    });
    svg.addEventListener('keydown', (e) => {
      const days = [...svg.querySelectorAll<SVGGElement>('.day')];
      let i = days.findIndex((g) => g.dataset.date === focused);
      if (i < 0) i = days.length - 1;
      const delta: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 };
      if (e.key in delta) {
        e.preventDefault();
        i = Math.max(0, Math.min(days.length - 1, i + delta[e.key]));
        focused = days[i].dataset.date!;
        clearFocus();
        markFocus(focused);
        show(focused);
        placeTip(focused, days[i]);
      } else if (e.key === 'Enter' && focused) {
        pinned = focused;
        show(focused);
      } else if (e.key === 'Escape') {
        pinned = null;
        focused = null;
        clearFocus();
        tip.hidden = true;
      }
    });
    svg.addEventListener('blur', () => { if (!pinned) tip.hidden = true; });
  }

  root.querySelectorAll<HTMLButtonElement>('.src').forEach((b) => {
    b.addEventListener('click', () => {
      const k = b.dataset.source as SourceKey;
      if (hidden.has(k)) hidden.delete(k); else hidden.add(k);
      b.setAttribute('aria-pressed', String(!hidden.has(k)));
      paint();
    });
  });
  root.querySelectorAll<HTMLButtonElement>('.step').forEach((b) => {
    b.addEventListener('click', () => gotoYear(years[idx + Number(b.dataset.step)]));
  });
  root.querySelectorAll<HTMLButtonElement>('.yr').forEach((b) => {
    b.addEventListener('click', () => gotoYear(Number(b.dataset.year)));
  });
</script>

<style>
  .pulse { position: relative; padding: 0.5rem 1.5rem 2.5rem; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .yearnav { display: inline-flex; align-items: center; gap: 0.1rem; background: var(--surface); border-radius: 999px; padding: 0.15rem; }
  #pulse-year { font-size: 0.85rem; color: var(--ink); font-weight: 500; padding: 0 0.5rem; }
  .step { all: unset; cursor: pointer; display: inline-grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 999px; color: var(--ink); font: inherit; font-size: 1.05rem; }
  .step:hover { background: var(--surface-2); }
  .step:disabled { color: var(--faint); cursor: default; background: none; }

  .legend { display: inline-flex; gap: 0.4rem; flex-wrap: wrap; }
  .src { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--sans); font-size: 0.82rem; font-weight: 500; color: var(--ink); padding: 0.25rem 0.75rem 0.25rem 0.35rem; border-radius: 999px; background: var(--surface); transition: background 150ms ease, color 150ms ease, opacity 150ms ease; }
  .src:hover { background: var(--surface-2); }
  .mark { display: inline-grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 6px; }
  .mark :global(svg), .mark img { width: 0.8rem; height: 0.8rem; display: block; }
  .mark.cio { background: var(--cio-tint); color: var(--cio); }
  .mark.vidyard { background: #fff; border-radius: 999px; }
  .mark.vidyard img { width: 1.05rem; height: 1.05rem; border-radius: 999px; }
  .mark.personal i { width: 0.7rem; height: 0.7rem; border-radius: 3px; background: var(--personal); display: block; }
  .mark.agent { color: var(--agent); }
  .mark.agent :global(svg) { width: 0.95rem; height: 0.95rem; }
  .src[aria-pressed="false"] { color: var(--muted); background: transparent; box-shadow: inset 0 0 0 1px var(--line); }
  .src[aria-pressed="false"] .mark { filter: grayscale(1); opacity: 0.45; }

  .strip-a, .strip-b { display: none; }
  .months { display: block; margin-bottom: 2px; overflow: visible; }
  .months :global(text) { font-size: 9px; fill: var(--muted); font-family: var(--mono); }
  .grid { display: block; outline: none; overflow: visible; border-radius: var(--r-s); }
  .grid :global(.dow) { font-size: 8.5px; fill: var(--faint); font-family: var(--mono); }
  .grid :global(.bg) { fill: var(--surface); }
  .grid :global(.bg.future) { fill: transparent; }
  .grid :global(.baseline) { stroke: var(--ink); stroke-width: 1; opacity: 0.4; }
  .grid :global(.day rect) { transition: y 220ms cubic-bezier(.2,.7,.2,1), height 220ms cubic-bezier(.2,.7,.2,1); }
  .grid :global(.day:hover .bg), .grid :global(.day.focus .bg) { fill: var(--surface-2); stroke: var(--ink); stroke-width: 1; }
  .grid :global(.day) { cursor: crosshair; }

  /* One orchestrated entrance: bars rise from the baseline, staggered by week. */
  .grid.enter :global(rect[data-source]) { transform-box: fill-box; transform-origin: bottom; animation: rise 520ms cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--c, 0) * 9ms); }
  @keyframes rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  .tip[hidden] { display: none; }
  .tip { position: absolute; top: 0; left: 0; z-index: 2; pointer-events: none; background: var(--ink); color: var(--bg); padding: 0.5rem 0.65rem; border-radius: var(--r-m); display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.7rem; box-shadow: 0 6px 18px rgba(16, 24, 32, 0.18); white-space: nowrap; }
  .tip :global(b) { font-weight: 500; margin-bottom: 0.15rem; }
  .tip :global(span) { display: inline-flex; align-items: center; gap: 0.45rem; }
  .tip :global(i) { width: 0.5rem; height: 0.5rem; border-radius: 2px; display: inline-block; }
  .tip :global(.quiet) { color: var(--faint); }

  .readout { margin: 1rem 0 0; min-height: 1.3em; color: var(--muted); transition: color 150ms ease; }
  .readout.live { color: var(--ink); font-weight: 500; }

  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin: 1.25rem 0 0; }
  .stats div { background: var(--surface); border-radius: var(--r-l); padding: 0.9rem 1rem 0.8rem; }
  .stats dd { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .stats dt { margin-top: 0.35rem; color: var(--muted); font-size: 0.82rem; }
  .stats div.claude dd { color: var(--agent); }
  .stats dt span { color: var(--ink); font-weight: 600; }

  .career { display: flex; gap: 0.35rem; align-items: flex-end; margin-top: 1.5rem; overflow-x: auto; }
  .yr { all: unset; cursor: pointer; flex: 1 1 0; min-width: 1.6rem; display: flex; flex-direction: column; align-items: stretch; gap: 0.35rem; padding: 0.25rem 0.15rem; border-radius: var(--r-m); transition: background 150ms ease; }
  .yr:hover { background: var(--surface); }
  .yr[aria-pressed="true"] { background: var(--surface); }
  .yr[aria-pressed="true"] .lbl { color: var(--ink); font-weight: 500; }
  .bar { display: flex; flex-direction: column-reverse; height: 2.6rem; border-radius: var(--r-s); overflow: hidden; background: var(--surface); }
  .yr[aria-pressed="true"] .bar { background: var(--surface-2); }
  .bar i { display: block; width: 100%; }
  .bar i[data-source="cio"] { background: var(--cio); }
  .bar i[data-source="vidyard"] { background: var(--vidyard); }
  .bar i[data-source="personal"] { background: var(--personal); }
  .bar i[data-source="agent"] { background: var(--agent); }
  .lbl { text-align: center; color: var(--faint); font-size: 0.66rem; }

  @media (max-width: 40rem) {
    .strip-full { display: none; }
    .strip-a, .strip-b { display: block; }
    .strip-b { margin-top: 0.9rem; }
    .months :global(text) { font-size: 11px; }
    .grid :global(.dow) { font-size: 10px; }
    .legend { gap: 0.3rem; }
    .src { font-size: 0.76rem; padding: 0.2rem 0.6rem 0.2rem 0.3rem; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .yr { min-width: 0; padding: 0.2rem 0.05rem; overflow: hidden; }
    .lbl { font-size: 0.55rem; }
    .career { gap: 0.2rem; overflow-x: visible; }
    .tip { display: none; }
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (prefers-reduced-motion: reduce) {
    .grid :global(.day rect), .src, .readout, .yr { transition: none; }
    .grid.enter :global(rect[data-source]) { animation: none; }
  }
</style>

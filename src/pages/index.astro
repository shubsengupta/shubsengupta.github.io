---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Pulse from '../components/Pulse.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import pulse from '../data/pulse.json';
import projects from '../data/projects.yaml';
import { getCollection } from 'astro:content';
import type { PulseData } from '../lib/pulse';

type Project = { name: string; year: number; url: string; blurb: string };
const data = pulse as PulseData;
const list = projects as Project[];
const posts = (await getCollection('writing', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Shub Sengupta">
  <Masthead />
  <Pulse data={data} />

  <Section title="Who I am" id="who">
    <p>I'm an engineering manager at <a href="https://customer.io">Customer.io</a>. My team builds Design Studio, the editor people use to make email, in-app and push content. Before that I was at Vidyard.</p>
    <p>I live in Toronto. I still write a lot of code for a manager, and most of it lately is paired with an AI. The chart above shows how much.</p>
    <ul class="links">
      <li><a href="https://github.com/shubsengupta">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/shubsengupta">LinkedIn</a></li>
      <li><a href="mailto:hi@shub.ca">hi@shub.ca</a></li>
    </ul>
  </Section>

  <Section title="What I do" id="what">
    <p>Design Studio at Customer.io: a visual editor with an agent inside it that fixes templates, matches your brand, and explains what is wrong with a draft. I run the team that builds it.</p>
    <h3>Side projects</h3>
    <ul class="projects">
      {list.map((p) => (
        <li>
          <span class="mono year">{p.year}</span>
          <span><a href={p.url}>{p.name}</a> <span class="blurb">{p.blurb}</span></span>
        </li>
      ))}
    </ul>
  </Section>

  {posts.length === 0 ? (
    <section class="wrap" id="writing" aria-labelledby="writing-h">
      <div class="empty-row">
        <h2 id="writing-h">Writing</h2>
        <a class="mono count" href="/writing/">0 entries</a>
      </div>
    </section>
  ) : (
    <Section title="Writing" id="writing">
      <ul class="posts">
        {posts.map((p) => (
          <li><span class="mono year">{p.data.date.toISOString().slice(0, 10)}</span> <a href={`/writing/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    </Section>
  )}

  <Footer refreshed={data.generatedAt} />
</Base>
<style>
  .links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  h3 { margin: 1.75rem 0 0.6rem; font-size: 0.95rem; font-weight: 600; color: var(--muted); }
  .projects li, .posts li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; margin: 0.5rem 0; }
  .year { color: var(--faint); padding-top: 0.35rem; }
  .blurb { color: var(--muted); }
  #writing { padding: 0 1.5rem 2rem; }
  .empty-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.25rem; background: var(--surface); border-radius: var(--r-l); }
  .empty-row h2 { margin: 0; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; }
  .count { color: var(--muted); }
</style>
